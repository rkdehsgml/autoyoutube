# 복사해서 .env 로 저장 (절대 커밋 금지). GitHub에서는 같은 이름으로 Secrets에 등록.

# agent --live: Claude Agent SDK 가 ANTHROPIC_API_KEY 를 쓴다 (필수). 스톡 영상은 PEXELS_API_KEY.
# v0 대본 LLM — channel.yaml providers.llm 과 맞춰 하나만
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# TTS (providers.tts: google 일 때)
GOOGLE_TTS_API_KEY=

# 스톡 영상
PEXELS_API_KEY=

# 텔레그램 미리보기·승인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube 업로드 (scripts/get_youtube_token.py 로 발급)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Instagram 릴스 (선택)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=https://graph.facebook.com
IG_GRAPH_VERSION=v23.0
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
